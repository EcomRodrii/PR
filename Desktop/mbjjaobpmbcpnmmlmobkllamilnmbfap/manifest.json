{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "LamineResell — Monitor Vinted",
  "version": "1.0.1",
  "description": "Monitoriza oportunidades de reventa en Vinted y analiza rendimiento, ventas y competencia. LamineResell.",
  "icons": {
    "16": "icons/icon-pro-16.png",
    "32": "icons/icon-pro-32.png",
    "48": "icons/icon-pro-48.png",
    "128": "icons/icon-pro-128.png"
  },
  "permissions": ["alarms", "tabs", "scripting", "storage"],
  "host_permissions": [
    "https://api.blackstock.es/*",
    "http://127.0.0.1:8788/*",
    "http://localhost:8788/*",
    "https://www.vinted.es/*",
    "https://discord.com/*",
    "https://ptb.discord.com/*",
    "https://canary.discord.com/*",
    "https://discordapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LamineResell — Monitor Vinted",
    "default_icon": {
      "16": "icons/icon-pro-16.png",
      "32": "icons/icon-pro-32.png",
      "48": "icons/icon-pro-48.png",
      "128": "icons/icon-pro-128.png"
    }
  }
}
